  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node community-backend/server.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.landing.app",
    "copyright": "bydashuaibi",
    "productName": "着陆",
    "files": [
      "index.html",
