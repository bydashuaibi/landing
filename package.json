{
  "name": "landing",
  "version": "2.5.0",
  "description": "着陆 · 每天一点，慢慢做到 —— 课后自学、学习断点与专注行动",
  "author": "bydashuaibi",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.landing.app",
    "productName": "着陆",
    "copyright": "Copyright © 2026 bydashuaibi",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "../../../build",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "app.js",
      "digest.js",
      "digest.css",
      "digest-network.cjs",
      "discipline.js",
      "discipline.css",
      "learning-checkpoint.js",
      "pet.js",
      "study-buddy.js",
      "study-buddy.css",
      "cyber-cat.js",
      "warp-text.js",
      "click-feedback.js",
      "gradient-waves.js",
      "main.js",
      "preload.js",
      "jwgl.js",
      "ask.html",
      "ask.js",
      "ask-preload.js",
      "package.json",
      "assets/icon.ico",
      "assets/pet/**/*",
      "assets/fonts/**/*",
      "petdex-sprite.js",
      "desktop-pet.cjs",
      "desktop-pet-preload.js",
      "desktop-pet.html",
      "desktop-pet.css",
      "desktop-pet-ui.js",
      "desktop-pet-bridge.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "着陆-${version}-便携版.${ext}"
    },
    "portable": {
      "artifactName": "着陆-${version}-便携版.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
