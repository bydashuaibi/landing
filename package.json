{
  "name": "landing",
  "version": "2.11.0",
  "description": "StudyTrail 学迹 · 学习进度、专注计划与桌宠陪伴 · 学びのあと",
  "author": "bydashuaibi",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --win --dir",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "locales:build": "node tools/build-locales.cjs"
  },
  "build": {
    "appId": "com.landing.app",
    "productName": "StudyTrail",
    "copyright": "Copyright © 2026 bydashuaibi",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "app.js",
      "ledger.js",
      "ledger-core.js",
      "ledger-exchange.js",
      "ledger.css",
      "digest.js",
      "digest.css",
      "digest-network.cjs",
      "discipline.js",
      "discipline.css",
      "learning-checkpoint.js",
      "pet.js",
      "study-buddy.js",
      "study-buddy.css",
      "cyber-cat.js",
      "warp-text.js",
      "click-feedback.js",
      "gradient-waves.js",
      "main.js",
      "preload.js",
      "jwgl.js",
      "ask.html",
      "ask.js",
      "ask-preload.js",
      "package.json",
      "assets/icon.ico",
      "assets/pet/**/*",
      "assets/fonts/**/*",
      "petdex-sprite.js",
      "desktop-pet.cjs",
      "desktop-pet-settings-preload.js",
      "desktop-pet-settings.html",
      "desktop-pet-settings.css",
      "desktop-pet-settings.js",
      "desktop-pet-preload.js",
      "desktop-pet.html",
      "desktop-pet.css",
      "desktop-pet-ui.js",
      "desktop-pet-bridge.js",
      "auto-launch.cjs",
      "ui-polish.css",
      "ui-polish.js",
      "market.js",
      "market.css",
      "pet-skins.cjs",
      "pet-skins-window-preload.js",
      "pet-skins-window.html",
      "pet-skins-window.js",
      "pet-skins-window.css",
      "pet-adventure.js",
      "pet-adventure.css",
      "sage-studio.css",
      "sage-studio.js",
      "locales.js",
      "i18n-core.js",
      "i18n.js",
      "trail-shop.js",
      "trail-shop.css",
      "focus-monitor-main.cjs",
      "focus-monitor.js",
      "focus-monitor.css",
      "focus-notice-preload.js",
      "focus-notice.html",
      "focus-notice.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "StudyTrail-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "StudyTrail-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "StudyTrail-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "StudyTrail-${version}-Linux-${arch}.${ext}",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
